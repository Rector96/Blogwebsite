# Gemini — AI headline & summary enrichment
GEMINI_API_KEY=

# Public site URL (canonical / absolute links)
APP_URL=https://your-domain.com

# Supabase (read articles + optional newsletter)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only: write articles from cron ingest
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protect cron-job.org webhook (required in production)
CRON_SECRET=change-me-long-random-string
