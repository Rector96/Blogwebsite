# Gemini — AI headline & summary enrichment
GEMINI_API_KEY=

# OpenAI — sports prediction outlooks (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public site URL (canonical / absolute links)
APP_URL=

# Supabase (read articles + optional newsletter)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only: write articles from cron ingest
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protect cron-job.org webhook (required in production)
CRON_SECRET=change-me-long-random-string

# API-Football (live scores + fixtures) — exact name matters
API_FOOTBALL_KEY=

# Optional sports affiliate button
SPORTS_AFFILIATE_URL=

# Stock images when RSS has no thumbnail (safe licenses)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Make.com — auto social posts after ingest
MAKE_WEBHOOK_URL=
SOCIAL_MAX_POSTS=3

# AdSense (only after approval)
VITE_ADSENSE_CLIENT_ID=

# Public URL used for Kora redirect/webhook callbacks (set to your real deployed domain)
PUBLIC_SITE_URL=

# Kora — primary advertising payment gateway (server-only)
KORA_SECRET_KEY=

# Admin — server-only authentication
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
