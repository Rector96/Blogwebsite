# Gemini — AI headline & summary enrichment
GEMINI_API_KEY=

# Public site URL (canonical / absolute links)
APP_URL=https://your-domain.com

# Supabase (read articles + optional newsletter)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only: write articles from cron ingest
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protect cron-job.org webhook (required in production)
CRON_SECRET=change-me-long-random-string

# Public canonical site URL used by sitemap
PUBLIC_SITE_URL=https://rwdnews.netlify.app

# Admin dashboard (server-only Netlify variables)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Google AdSense — only add these after AdSense approves the site
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_LEADER_SLOT=
VITE_ADSENSE_INFEED_SLOT=
VITE_ADSENSE_SIDEBAR_SLOT=
